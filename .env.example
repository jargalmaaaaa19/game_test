# Room server configuration. Copy to `.env` and fill in — `.env` is gitignored,
# and every secret belongs there and nowhere else. Never commit a real value to
# this file: it is a checked-in list of NAMES, not of settings.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

PORT=3200

# Browser origins allowed to open a socket, comma separated. `*` matches ONE
# hostname label, so `https://*.vercel.app` keeps preview deployments working
# without widening into someone else's subdomain.
#
# Unset means allow any origin, and that is deliberate — see config.js for why
# a wrong allow-list here breaks real players and guards nothing.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Usion platform
#
# The server verifies the player's Usion access token as RS256 against the
# platform's PUBLIC JWKS. Verification uses public keys, so none of the values
# below are secret and none of them is an API key. If you have been issued a
# `usion_sk_...` secret key, it is for calling the Usion API *as the service*,
# which this server does not currently do — wire the caller first, then add the
# variable it reads. A key sitting in the environment that no code path uses is
# an exposure with no upside.
# ---------------------------------------------------------------------------

# Identifies this service. Its presence is also what flips auth on by default:
# tokens are minted for a specific service, so a deployment without one could
# never receive a valid token, and demanding one would reject 100% of traffic.
USION_SERVICE_ID=

# Expected `aud`. Defaults to USION_SERVICE_ID when unset.
USION_TOKEN_AUDIENCE=

# Force token verification either way. Leave unset to follow USION_SERVICE_ID.
# DO turn it on for anything real: without it, whoever has the URL opens rooms.
USION_AUTH_REQUIRED=

USION_JWKS_URL=https://usions.com/.well-known/jwks.json
USION_TOKEN_ISSUER=https://usions.com

# The service SECRET key (`usion_sk_...`). Authenticates this service TO the
# platform — registering the game, and any later server-side Usion API call.
# Nothing to do with verifying player tokens, which use the public JWKS above.
#
# NEVER commit a value here, and never put it in the CLIENT environment: a
# `VITE_`-prefixed variable is compiled into the bundle and served to every
# player. This one belongs in the room server's environment only (Railway), or
# in a local `.env`, which is gitignored.
USION_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

# Unlocks the dev-only socket events and the forced programme below. Must be
# off in production: it lets a client resolve an event with any placements.
DEV_TOOLS=false

# Force the match programme while building a sport, e.g. `hammer_throw`.
# Only honoured when DEV_TOOLS is on.
DEV_PROGRAMME=

# Two players may not compete under the same flag.
UNIQUE_FLAGS=true

LOG_LEVEL=info
