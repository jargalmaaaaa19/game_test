# Where the Socket.IO room server lives.
#
# Local:      http://localhost:3200   (the default when this is unset)
# Deployed:   https://<your-app>.up.railway.app
#
# This CANNOT point at the Vercel deployment itself: Vercel runs serverless
# functions, which cannot hold a WebSocket open. Vercel hosts this client only;
# the room server needs a host that runs a long-lived process.
VITE_SERVER_URL=http://localhost:3200
